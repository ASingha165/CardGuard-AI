# CardGuard AI Environment Configuration

# Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cardguard.db
API_KEY_SECRET=change-me-to-a-strong-random-secret
REQUIRE_AUTH=false
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_DIR=./data/models
UPLOAD_DIR=./data/uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-to-a-strong-random-secret
